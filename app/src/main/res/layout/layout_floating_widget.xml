<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Sleek Oval / Circular Chathead Bubble -->
    <FrameLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/imgBubble"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_floating_bubble_disconnected"
            android:src="@drawable/ic_proxy_shield"
            android:padding="12dp"
            android:elevation="8dp"
            android:contentDescription="Proxy Floating Bubble" />

        <!-- Live status indicator dot: Green = Connected, Red = Disconnected -->
        <View
            android:id="@+id/statusIndicatorDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="3dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_status_dot_disconnected"
            android:elevation="9dp" />
    </FrameLayout>

    <!-- Realtime dynamic text badge directly below bubble -->
    <LinearLayout
        android:id="@+id/layoutPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_floating_info_pill"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:gravity="center_horizontal"
        android:elevation="6dp">

        <TextView
            android:id="@+id/txtDynamicGeo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFF | ---"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="10sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="00:00:00"
            android:textColor="#90A4AE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- Expandable Premium Glassmorphic Compact Card -->
    <LinearLayout
        android:id="@+id/cardDetails"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_premium_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        android:elevation="12dp">

        <TextView
            android:id="@+id/txtCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proxy Tunnel"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtDetailCountryCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Location: ---"
            android:textColor="#CFD8DC"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtDetailIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="IP: ---"
            android:textColor="#90A4AE"
            android:textSize="10sp" />

        <!-- 1-Click Connect / Disconnect Action Button -->
        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:text="Connect"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#00E676"
            android:padding="0dp" />

    </LinearLayout>

</LinearLayout>
