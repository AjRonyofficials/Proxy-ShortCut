<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_proxy_shield"
                android:contentDescription="Proxy Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proxy Shortcut"
                    android:textColor="#00E676"
                    android:textStyle="bold"
                    android:textSize="22sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tun2Socks + Floating Bubble"
                    android:textColor="#90A4AE"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 1-Click Smart Auto Paste Button -->
        <Button
            android:id="@+id/btnClipboard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚡ 1-Click Smart Auto Paste"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#00E676"
            android:backgroundTint="#1A2721"
            android:layout_marginBottom="16dp" />

        <!-- Profile Settings Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_premium_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROXY SERVER CONFIGURATION"
                android:textColor="#00E676"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp"/>

            <!-- Profile Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile Name"
                android:textColor="#90A4AE"
                android:textSize="11sp"/>
            <EditText
                android:id="@+id/edtProfileName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:hint="e.g. My Fast Proxy"
                android:textColorHint="#455A64"
                android:textColor="#FFFFFF"
                android:background="#161A22"
                android:paddingHorizontal="12dp"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:inputType="text" />

            <!-- Server IP and Port -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Server / Host IP *"
                        android:textColor="#90A4AE"
                        android:textSize="11sp"/>
                    <EditText
                        android:id="@+id/edtHost"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="192.168.1.1"
                        android:textColorHint="#455A64"
                        android:textColor="#FFFFFF"
                        android:background="#161A22"
                        android:paddingHorizontal="12dp"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"
                        android:inputType="textUri" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Port *"
                        android:textColor="#90A4AE"
                        android:textSize="11sp"/>
                    <EditText
                        android:id="@+id/edtPort"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="1080"
                        android:textColorHint="#455A64"
                        android:textColor="#FFFFFF"
                        android:background="#161A22"
                        android:paddingHorizontal="12dp"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <!-- Username and Password -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username (Optional)"
                        android:textColor="#90A4AE"
                        android:textSize="11sp"/>
                    <EditText
                        android:id="@+id/edtUsername"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="user"
                        android:textColorHint="#455A64"
                        android:textColor="#FFFFFF"
                        android:background="#161A22"
                        android:paddingHorizontal="12dp"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"
                        android:inputType="text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password (Optional)"
                        android:textColor="#90A4AE"
                        android:textSize="11sp"/>
                    <EditText
                        android:id="@+id/edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="password"
                        android:textColorHint="#455A64"
                        android:textColor="#FFFFFF"
                        android:background="#161A22"
                        android:paddingHorizontal="12dp"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"
                        android:inputType="textPassword" />
                </LinearLayout>
            </LinearLayout>

            <!-- Protocol Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proxy Protocol"
                android:textColor="#90A4AE"
                android:textSize="11sp"
                android:layout_marginTop="12dp"/>

            <RadioGroup
                android:id="@+id/rgProtocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rbSocks5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOCKS5 (Tun2Socks)"
                    android:textColor="#ECEFF1"
                    android:checked="true"
                    android:textSize="13sp"/>

                <RadioButton
                    android:id="@+id/rbHttp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="HTTP"
                    android:textColor="#ECEFF1"
                    android:textSize="13sp"/>
            </RadioGroup>

        </LinearLayout>

        <!-- Routing Rules Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_premium_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECTIVE ROUTING"
                android:textColor="#00E676"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <Switch
                android:id="@+id/switchRouteAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Route All Apps (Off = Selected Only)"
                android:textColor="#ECEFF1"
                android:checked="true"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnSelectApps"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="Select Specific Apps"
                android:textColor="#ECEFF1"
                android:backgroundTint="#263238"/>
        </LinearLayout>

        <!-- Save Profile Button -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="Save Proxy Profile"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#00E676"/>

        <!-- Launch Floating Bubble Button -->
        <Button
            android:id="@+id/btnStartFloating"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="Launch Floating Bubble Overlay"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2979FF"/>

    </LinearLayout>
</ScrollView>
