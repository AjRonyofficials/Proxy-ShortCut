<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_proxy_shield"
                android:contentDescription="Proxy Shortcut Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proxy Shortcut"
                    android:textColor="#00E676"
                    android:textStyle="bold"
                    android:textSize="22sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tun2Socks + Floating Widget"
                    android:textColor="#90A4AE"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROXY CONFIGURATION"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/edtPaste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste raw proxy (ip:port:user:pass)"
            android:textColorHint="#546E7A"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_premium_card"
            android:padding="16dp"
            android:textSize="14sp"
            android:minHeight="54dp"
            android:inputType="textUri|textMultiLine" />

        <Button
            android:id="@+id/btnClipboard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="1-Click Auto Paste"
            android:textColor="#FFFFFF"
            android:backgroundTint="#263238"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E222D"
            android:layout_marginVertical="18dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROUTING PREFERENCES"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_premium_card"
            android:orientation="vertical"
            android:padding="16dp">

            <Switch
                android:id="@+id/switchAllApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Route All Apps (Off = Selected Only)"
                android:textColor="#CFD8DC"
                android:checked="true"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnSelectApps"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="Select Specific Apps"
                android:textColor="#ECEFF1"
                android:backgroundTint="#37474F"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Save Profile"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#00E676"/>

        <Button
            android:id="@+id/btnStartFloating"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Launch Floating Overlay"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2979FF"/>

    </LinearLayout>
</ScrollView>
